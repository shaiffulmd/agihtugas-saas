Options -Indexes
DirectoryIndex index.php
# Halaman ralat seragam (lihat app/errors.php). ralat.html ialah sandaran statik jika PHP tidak dapat berjalan.
ErrorDocument 400 /index.php?page=ralat&kod=400
ErrorDocument 403 /index.php?page=ralat&kod=403
ErrorDocument 404 /index.php?page=ralat&kod=404
ErrorDocument 500 /ralat.html
ErrorDocument 502 /ralat.html
ErrorDocument 503 /ralat.html
ErrorDocument 504 /ralat.html
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]
</IfModule>
# Mampatan gzip untuk HTML/CSS/JS/JSON/SVG (halaman besar seperti senarai jawatan mengecil ~90%). PDF & imej tidak dimampatkan.
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
# Aset statik disimpan 7 hari oleh pelayar. CSS/JS utama dirujuk dengan ?v=hash (asset()) jadi kemas kini terus berkuat kuasa;
# fail tanpa versi (fonts.css, ralat.html) paling lama 7 hari.
<IfModule mod_headers.c>
<FilesMatch "\.(css|js|woff2|png|webp|jpg|svg|ico)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
</IfModule>
