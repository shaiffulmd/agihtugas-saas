# Tidak perlu diisi jika menggunakan pemasang web (/install.php) — ia mencipta .env secara automatik.
APP_NAME="UrusTugas"
APP_ENV=production
APP_KEY=GENERATE_WITH_BIN_KEY
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=urustugas
DB_USER=urustugas_app
DB_PASS=CHANGE_ME
SESSION_SECURE=1
REQUIRE_2FA=1
# Edisi multi: domain induk (tanpa https://). Sekolah: https://DOMAIN/KOD/ atau https://kod.DOMAIN/ (perlu DNS & SSL wildcard).
PLATFORM_DOMAIN=urustugas.contoh.my
# Bentuk URL utama: path (/KOD/) atau subdomain (kod.domain). Bentuk lain dilencongkan (302).
# Domain induk & subdomain sekolah boleh diurus di Panel Platform → Subdomain Sekolah (mengatasi dua tetapan ini).
TENANT_PRIMARY=path

# Pautan antara laman utama dan laman demo (pilihan, URL penuh https://).
#   Laman utama: DEMO_URL  → menu "Demo", butang "Cuba demo" dan bahagian "Demo tanpa daftar".
#   Laman demo (DEMO_MODE=1): DAFTAR_URL → semua butang daftar menjadi "Sedia untuk daftar" ke laman utama; /daftar demo dilencongkan.
# DEMO_URL=https://demo.urustugas.contoh.my
# DAFTAR_URL=https://urustugas.contoh.my/daftar

# Kemas kini automatik daripada GitHub (lihat docs/KEMASKINI-GITHUB.md). Kosongkan untuk mematikan.
UPDATE_REPO=
UPDATE_TOKEN=
UPDATE_SECRET=
# UPDATE_TAG=terkini
# UPDATE_AUTO=1

# Log masuk tunggal (SSO) melalui Portal Akaun — pilihan. Kosongkan untuk mematikan (log masuk kata laluan tempatan kekal).
# Nilai diberi oleh Panel Pentadbir Portal → Servis (SSO). Rahsia dipaparkan sekali sahaja. Lihat docs/SSO.md.
# SSO_PORTAL_URL=https://akaun.contoh.my
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
