# Runtime data, API key hashes, logs and generated previews
/storage/*
!/storage/.gitkeep
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.log

# Local secrets and machine-specific configuration
.env
.env.*
!.env.example
*.pem
*.key
/integrations/koku-multi/config.local.php
/config/local.php
/dist/

# Dependencies and generated packages
/vendor/
/node_modules/
*.zip
*.tar.gz

# Editor and OS files
.DS_Store
.idea/
.vscode/
*.swp
*.swo
