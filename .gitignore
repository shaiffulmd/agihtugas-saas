# Runtime data (pemasangan, sandaran, log, PDF sementara)
/storage/*
!/storage/.gitkeep
!/storage/.htaccess
/legacy/storage/*
!/legacy/storage/.gitkeep
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.db
*.db-*
*.log

# Rahsia setempat
.env
.env.*
!.env.example
*.pem
*.key
/legacy/integrations/koku-multi/config.local.php
/legacy/config/local.php
/dist/

# Kebergantungan & pakej (vendor/.htaccess dijejak secara paksa: fail perlindungan buatan sendiri)
/vendor/*
!/vendor/.htaccess
/node_modules/
*.zip
*.tar.gz
/public_html/install.php.locked-*

# Editor & OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo
__pycache__/
